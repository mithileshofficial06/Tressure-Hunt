# Copy to .env.local and fill in. Nothing here is read at build time —
# the app boots without it and shows an in-theme "database not configured"
# panel instead of crashing, so you can style before you have credentials.

# ── Required ────────────────────────────────────────────────────────────────
# Mongo connection string. Atlas or local both work.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=xplore26

# Signs the team cookie. Any long random string; changing it logs everyone out.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Typed into the team-number box on the registration screen to open the admin
# board. Defaults to 0904 if unset. Server-side only — never sent to the browser,
# so do NOT rename this to NEXT_PUBLIC_*.
ADMIN_CODE=0904

# ── Optional ────────────────────────────────────────────────────────────────
# Highest team number that may be claimed (numbers run 1..MAX). Default 60.
# Read at runtime on the server and handed to the form as a prop, so editing
# this and restarting is enough — no rebuild needed.
# MUST MATCH `MAX_TEAM` in shift-verse-app/lib/teamRange.ts — this app hands out
# the numbers, and that app needs a seeded puzzle for every number handed out.
MAX_TEAMS=60

# Base URLs of the round apps. Each tile links to `${BASE}/game?team=N`.
# Server-side only — not NEXT_PUBLIC_, so a restart picks up a change.
SHIFTVERSE_URL=http://localhost:3001
OCTAVIUS_URL=http://localhost:3003
