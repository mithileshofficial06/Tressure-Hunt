# Copy to .env.local and fill in.

# The SAME cluster the dashboard uses. This app owns `octavius_progress`, and
# writes `hunt_progress` / `teams` only to credit a completed round.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=xplore26

# Where the "back to the hunt board" links point. NEXT_PUBLIC_ because it is
# read in a client component — a URL, not a secret. Inlined at build time.
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3000/dashboard
